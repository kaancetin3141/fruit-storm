generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id         String    @id @default(cuid())
  email      String?   @unique
  passHash   String?
  name       String
  avatar     Int       @default(0)
  progress   String    @default("{}")
  totalStars Int       @default(0)
  clanId     String?
  clan       Clan?     @relation(fields: [clanId], references: [id])
  sessions   Session[]
  chats      ClanChat[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  createdAt DateTime @default(now())
}

model Clan {
  id        String     @id @default(cuid())
  name      String     @unique
  ownerId   String
  players   Player[]
  chat      ClanChat[]
  createdAt DateTime   @default(now())
}

model ClanChat {
  id        String   @id @default(cuid())
  clanId    String
  clan      Clan     @relation(fields: [clanId], references: [id])
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id])
  n         String
  m         String
  ts        DateTime @default(now())
}
